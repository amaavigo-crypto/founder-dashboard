# SQLite for local dev; use Postgres in production, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/founders
DATABASE_URL=sqlite:///./founders.db
JWT_SECRET=change-me-to-a-long-random-string
PULL_SECRET=change-me-too
TIMEZONE=Asia/Kolkata
